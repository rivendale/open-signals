     "inputs": {"sleeve": "growth", "cash_and_cash_equivalents": 500, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"runway_quarters": 4.0, "fires": false}},
    {"id": "sr1b-just-under-four", "rule": "SR-1b", "case": "boundary", "doc": "docs/signals.md#runway",
     "description": "Liquidity 499: runway 3.992 quarters, fires.",
     "inputs": {"sleeve": "growth", "cash_and_cash_equivalents": 499, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"runway_quarters": 3.992, "fires": true}},
    {"id": "sr1b-sbc-only-does-not-fire", "rule": "SR-1b", "case": "edge", "doc": "docs/signals.md#runway",
     "description": "Cash-generating business (operating cash flow +100, no capex) whose free cash flow is negative only because of stock-based compensation of 150. Heavy debt service gives a runway of 2 quarters, but the cash gate is not met: SR-1b does not fire.",
     "inputs": {"sleeve": "growth", "stock_based_compensation": 150, "cash_and_cash_equivalents": 100, "operating_cash_flow_ttm": 100, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 0, "scheduled_debt_service_next_12m": 200},
     "expected": {"operating_cash_burn": 0, "runway_quarters": 2.0, "burns_cash": false, "fires": false}},
    {"id": "sr1b-gate-met-unlimited", "rule": "SR-1b", "case": "edge", "doc": "docs/signals.md#runway",
     "description": "TTM capex 100 meets the gate, but no capex is planned and nothing else is due: outflow 0, runway unlimited, does not fire.",
     "inputs": {"sleeve": "growth", "cash_and_cash_equivalents": 10, "operating_cash_flow_ttm": 0, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 100},
     "expected": {"burns_cash": true, "runway_quarters": "unlimited", "fires": false}},
    {"id": "sr1b-speculative-sleeve", "rule": "SR-1b", "case": "edge", "doc": "docs/pipeline.md#speculative-sleeve",
     "description": "The doc example in the speculative sleeve: not applied.",
     "inputs": {"sleeve": "speculative", "cash_and_cash_equivalents": 150, "short_term_investments": 50, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"fires": "not_applied"}},

    {"id": "k2-debt-service-alone", "rule": "K2", "case": "fail", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "No burn, but debt service 200 against liquidity 100: runway 2 quarters, K2 fires (it needs no burn).",
     "inputs": {"capital_intensive_builder": true, "cash_and_cash_equivalents": 100, "operating_cash_flow_ttm": 100, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 0, "scheduled_debt_service_next_12m": 200},
     "expected": {"runway_quarters": 2.0, "fires": true}},
    {"id": "k2-long-runway", "rule": "K2", "case": "pass", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "Liquidity 1,000 against debt service 200: runway 20 quarters.",
     "inputs": {"capital_intensive_builder": true, "cash_and_cash_equivalents": 1000, "operating_cash_flow_ttm": 100, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 0, "scheduled_debt_service_next_12m": 200},
     "expected": {"runway_quarters": 20.0, "fires": false}},
    {"id": "k2-exactly-four", "rule": "K2", "case": "boundary", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "Runway exactly 4 quarters: does not fire.",
     "inputs": {"capital_intensive_builder": true, "cash_and_cash_equivalents": 200, "operating_cash_flow_ttm": 100, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 0, "scheduled_debt_service_next_12m": 200},
     "expected": {"runway_quarters": 4.0, "fires": false}},
    {"id": "k2-not-a-builder", "rule": "K2", "case": "edge", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "K2 is a shared criterion for capital-intensive builders only.",
     "inputs": {"capital_intensive_builder": false, "cash_and_cash_equivalents": 100, "operating_cash_flow_ttm": 100, "capital_expenditure_ttm": 0, "scheduled_debt_service_next_12m": 200},
     "expected": {"fires": "not_applicable"}}
  ]
