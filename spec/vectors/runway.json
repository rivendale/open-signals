{
  "about": "Synthetic vectors for runway, SR-1b and K2. US GAAP filers only (see the runway ambiguity in spec/signals.json). Made-up numbers; no real company.",
  "vectors": [
    {"id": "runway-doc-example", "rule": "signal.runway", "case": "pass", "doc": "docs/signals.md#runway",
     "description": "The doc's example: liquidity 200, outflow 250 + 150 + 60 + 40 = 500, runway 1.6 quarters.",
     "inputs": {"cash_and_cash_equivalents": 150, "short_term_investments": 50, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"liquidity": 200, "operating_cash_burn": 250, "annual_outflow": 500, "runway_quarters": 1.6}},
    {"id": "runway-restricted-excluded", "rule": "signal.runway", "case": "edge", "doc": "docs/signals.md#runway",
     "description": "Restricted cash 1,000 and pledged investments 300 are recorded but never added: runway stays 1.6.",
     "inputs": {"cash_and_cash_equivalents": 150, "restricted_cash": 1000, "short_term_investments": 50, "pledged_or_restricted_investments": 300, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"liquidity": 200, "runway_quarters": 1.6}},
    {"id": "runway-facilities", "rule": "signal.runway", "case": "edge", "doc": "docs/signals.md#runway",
     "description": "Only the committed line with every condition met counts (100). An uncommitted line, an at-the-market program and a line with an unmet condition do not.",
     "inputs": {"cash_and_cash_equivalents": 150, "short_term_investments": 50,
                "facilities": [{"kind": "credit_line", "undrawn": 100, "committed": true, "conditions_met": true},
                               {"kind": "credit_line", "undrawn": 500, "committed": false, "conditions_met": true},
                               {"kind": "atm_equity_program", "undrawn": 1000, "committed": true, "conditions_met": true},
                               {"kind": "credit_line", "undrawn": 200, "committed": true, "conditions_met": false}],
                "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"liquidity": 300, "runway_quarters": 2.4}},
    {"id": "runway-leases-not-twice", "rule": "signal.runway", "case": "edge", "doc": "docs/signals.md#runway",
     "description": "Operating cash flow -290 already includes 30 of interest and 40 of operating-lease payments. They are added back (burn 220) because debt service and lease payments count them. No stated capex plan, so TTM capex 80 is used. Outflow 400, runway 3.0.",
     "inputs": {"cash_and_cash_equivalents": 300, "operating_cash_flow_ttm": -290, "interest_paid_in_ocf": 30, "operating_lease_payments_in_ocf": 40, "capital_expenditure_planned_next_12m": null, "capital_expenditure_ttm": 80, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
     "expected": {"operating_cash_burn": 220, "capital_expenditure_used": 80, "annual_outflow": 400, "runway_quarters": 3.0}},
    {"id": "runway-zero-outflow", "rule": "signal.runway", "case": "boundary", "doc": "docs/signals.md#runway",
     "description": "Annual outflow 0: runway is unlimited.",
     "inputs": {"cash_and_cash_equivalents": 10, "operating_cash_flow_ttm": 50, "capital_expenditure_planned_next_12m": 0, "capital_expenditure_ttm": 0},
     "expected": {"annual_outflow": 0, "runway_quarters": "unlimited"}},
    {"id": "runway-negative-lease-rejected", "rule": "signal.runway", "case": "fail", "doc": "docs/data-quality.md#fundamentals",
     "description": "Lease payments given as a negative number: rejected.",
     "inputs": {"cash_and_cash_equivalents": 100, "operating_cash_flow_ttm": -100, "lease_payments_next_12m": -40},
     "expect_error": "sign"},

    {"id": "sr1b-doc-example-fires", "rule": "SR-1b", "case": "fail", "doc": "docs/signals.md#runway",
     "description": "The doc's example: runway 1.6 quarters with cash burn; fires although funding dependence is not applicable.",
     "inputs": {"sleeve": "growth", "cash_and_cash_equivalents": 150, "short_term_investments": 50, "operating_cash_flow_ttm": -250, "capital_expenditure_planned_next_12m": 150, "capital_expenditure_ttm": 150, "scheduled_debt_service_next_12m": 60, "lease_payments_next_12m": 40},
