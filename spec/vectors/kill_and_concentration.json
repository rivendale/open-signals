{
  "about": "Synthetic vectors for K1, K3 and customer concentration. Made-up numbers; no real company or customer.",
  "vectors": [
    {"id": "k1-none", "rule": "K1", "case": "pass", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "No distress language.",
     "inputs": {"going_concern": false, "covenant_breach": false, "lender_waiver_or_forbearance": false},
     "expected": {"fires": false}},
    {"id": "k1-going-concern", "rule": "K1", "case": "fail", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A going-concern paragraph fires K1.",
     "inputs": {"going_concern": true},
     "expected": {"fires": true}},
    {"id": "k1-waiver", "rule": "K1", "case": "fail", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A lender waiver or forbearance alone fires K1.",
     "inputs": {"lender_waiver_or_forbearance": true},
     "expected": {"fires": true}},

    {"id": "k3-termination", "rule": "K3", "case": "fail", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A customer that was 40% of backlog terminates: K3 fires.",
     "inputs": {"event": "termination", "backlog_share_at_last_filing": 0.40},
     "expected": {"share_unverified": false, "fires": true}},
    {"id": "k3-small-cut", "rule": "K3", "case": "pass", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A 10% cut by a 40%-of-backlog customer does not fire.",
     "inputs": {"event": "contract_value_cut", "contract_value_cut_fraction": 0.10, "backlog_share_at_last_filing": 0.40},
     "expected": {"anchor_customer": true, "fires": false}},
    {"id": "k3-cut-exactly-25", "rule": "K3", "case": "boundary", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A cut of exactly 25% is not more than 25%: does not fire.",
     "inputs": {"event": "contract_value_cut", "contract_value_cut_fraction": 0.25, "backlog_share_at_last_filing": 0.40},
     "expected": {"fires": false}},
    {"id": "k3-cut-26", "rule": "K3", "case": "boundary", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A 26% cut fires.",
     "inputs": {"event": "contract_value_cut", "contract_value_cut_fraction": 0.26, "backlog_share_at_last_filing": 0.40},
     "expected": {"fires": true}},
    {"id": "k3-share-exactly-25", "rule": "K3", "case": "boundary", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "A customer that was exactly 25% of backlog is not more than 25%: its termination does not fire K3.",
     "inputs": {"event": "termination", "backlog_share_at_last_filing": 0.25},
     "expected": {"anchor_customer": false, "fires": false}},
    {"id": "k3-revenue-fallback", "rule": "K3", "case": "edge", "doc": "docs/kill-criteria.md#shared-criteria-for-capital-intensive-builders",
     "description": "Backlog by customer not disclosed: the 30% revenue share is used and marked unverified; a default fires K3.",
     "inputs": {"event": "default", "backlog_share_at_last_filing": null, "revenue_share_at_last_filing": 0.30},
     "expected": {"share_used": 0.30, "share_unverified": true, "fires": true}},

    {"id": "conc-doc-example", "rule": "signal.customer_concentration", "case": "fail", "doc": "docs/signals.md#customer-concentration",
     "description": "The doc's example: 600 of 1,000 from one customer, 60%. Flagged. No backlog by customer, so the backlog share falls back to revenue share, unverified.",
     "inputs": {"total_revenue": 1000, "total_backlog": null, "customers": [{"revenue": 600, "backlog": null}, {"revenue": 100, "backlog": null}]},
     "expected": {"top_customer_share": 0.6, "max_backlog_share": 0.6, "backlog_share_unverified": true, "flagged": true}},
    {"id": "conc-spread", "rule": "signal.customer_concentration", "case": "pass", "doc": "docs/signals.md#customer-concentration",
     "description": "Largest customer 20% of revenue and 20% of backlog: not flagged.",
     "inputs": {"total_revenue": 1000, "total_backlog": 2000, "customers": [{"revenue": 200, "backlog": 400}, {"revenue": 150, "backlog": 300}]},
     "expected": {"top_customer_share": 0.2, "max_backlog_share": 0.2, "backlog_share_unverified": false, "flagged": false}},
    {"id": "conc-exactly-25", "rule": "signal.customer_concentration", "case": "boundary", "doc": "docs/signals.md#customer-concentration",
     "description": "Exactly 25% of revenue and of backlog is not above 25%: not flagged.",
     "inputs": {"total_revenue": 1000, "total_backlog": 2000, "customers": [{"revenue": 250, "backlog": 500}]},
     "expected": {"top_customer_share": 0.25, "flagged": false}},
    {"id": "conc-backlog-only", "rule": "signal.customer_concentration", "case": "edge", "doc": "docs/signals.md#customer-concentration",
     "description": "A new contract: 20% of revenue but 60% of backlog. Flagged on backlog.",
     "inputs": {"total_revenue": 1000, "total_backlog": 2000, "customers": [{"revenue": 200, "backlog": 1200}]},
     "expected": {"top_customer_share": 0.2, "max_backlog_share": 0.6, "flagged": true}}
  ]
}
