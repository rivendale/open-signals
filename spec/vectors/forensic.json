{
  "about": "Synthetic vectors for the forensic flags. Made-up numbers; no real company.",
  "vectors": [
    {"id": "mscore-above-cutoff", "rule": "flag.mscore", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "A score of -1.50 is above a -1.78 cutoff: flag.",
     "inputs": {"m_score": -1.50, "cutoff": -1.78, "cutoff_source": "Beneish, Lee and Nichols (2013), Financial Analysts Journal 69(2)"},
     "expected": {"status": "flag"}},
    {"id": "mscore-low", "rule": "flag.mscore", "case": "pass", "doc": "docs/signals.md#forensic-flags",
     "description": "A score of -2.60 is below the band: no flag.",
     "inputs": {"m_score": -2.60, "cutoff": -1.78, "cutoff_source": "Beneish, Lee and Nichols (2013), Financial Analysts Journal 69(2)"},
     "expected": {"status": "none"}},
    {"id": "mscore-band", "rule": "flag.mscore", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "A score of -2.00 lies in this method's band: read more closely.",
     "inputs": {"m_score": -2.00, "cutoff": -1.78, "cutoff_source": "Beneish, Lee and Nichols (2013), Financial Analysts Journal 69(2)"},
     "expected": {"status": "read_closely"}},
    {"id": "mscore-at-cutoff", "rule": "flag.mscore", "case": "boundary", "doc": "docs/signals.md#forensic-flags",
     "description": "Exactly at the cutoff: the docs do not say which side it falls on.",
     "inputs": {"m_score": -1.78, "cutoff": -1.78, "cutoff_source": "Beneish, Lee and Nichols (2013), Financial Analysts Journal 69(2)"},
     "expected": {"status": "ambiguous_boundary"}},
    {"id": "mscore-at-band-floor", "rule": "flag.mscore", "case": "boundary", "doc": "docs/signals.md#forensic-flags",
     "description": "Exactly at -2.22: the docs do not say whether the band includes it.",
     "inputs": {"m_score": -2.22, "cutoff": -1.78, "cutoff_source": "Beneish, Lee and Nichols (2013), Financial Analysts Journal 69(2)"},
     "expected": {"status": "ambiguous_boundary"}},
    {"id": "mscore-no-source", "rule": "flag.mscore", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "An implementation records its cutoff with a source; none given is rejected.",
     "inputs": {"m_score": -1.50, "cutoff": -1.78},
     "expect_error": "source"},

    {"id": "event-none", "rule": "flag.event", "case": "pass", "doc": "docs/signals.md#forensic-flags",
     "description": "No auditor change, non-reliance notice or restatement.",
     "inputs": {"auditor_change_item_4_01": false, "non_reliance_item_4_02": false, "restatement": false},
     "expected": {"fires": false, "checked": "on_receipt"}},
    {"id": "event-auditor-change", "rule": "flag.event", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "An Item 4.01 auditor change is an event flag, checked on receipt.",
     "inputs": {"auditor_change_item_4_01": true},
     "expected": {"fires": true, "checked": "on_receipt"}},
    {"id": "event-restatement", "rule": "flag.event", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "A restatement is an event flag.",
     "inputs": {"restatement": true},
     "expected": {"fires": true}},

    {"id": "eac-ni-above-ocf", "rule": "flag.earnings_ahead_of_cash", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "Net income above operating cash flow in both of the latest two years: flag. With two years only, the accrual-ratio branch is ambiguous, but the first branch decides.",
     "inputs": {"years": [{"net_income": 100, "net_income_continuing_ops": 100, "operating_cash_flow": 80, "total_assets": 1000},
                          {"net_income": 120, "net_income_continuing_ops": 120, "operating_cash_flow": 90, "total_assets": 1000}]},
     "expected": {"total_accruals_to_total_assets": [0.02, 0.03], "net_income_above_ocf": true, "tata_rising": "ambiguous", "flag": true}},
    {"id": "eac-cash-ahead", "rule": "flag.earnings_ahead_of_cash", "case": "pass", "doc": "docs/signals.md#forensic-flags",
     "description": "Cash above earnings every year and the accrual ratio falling: no flag.",
     "inputs": {"years": [{"net_income": 80, "net_income_continuing_ops": 80, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 70, "net_income_continuing_ops": 70, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 60, "net_income_continuing_ops": 60, "operating_cash_flow": 100, "total_assets": 1000}]},
     "expected": {"net_income_above_ocf": false, "tata_rising": false, "flag": false}},
    {"id": "eac-equal-not-above", "rule": "flag.earnings_ahead_of_cash", "case": "boundary", "doc": "docs/signals.md#forensic-flags",
     "description": "Net income equal to operating cash flow in the latest year is not above it; the accrual ratio falls: no flag.",
     "inputs": {"years": [{"net_income": 50, "net_income_continuing_ops": 50, "operating_cash_flow": 0, "total_assets": 1000},
                          {"net_income": 110, "net_income_continuing_ops": 110, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 100, "net_income_continuing_ops": 100, "operating_cash_flow": 100, "total_assets": 1000}]},
     "expected": {"net_income_above_ocf": false, "tata_rising": false, "flag": false}},
    {"id": "eac-accruals-rising-twice", "rule": "flag.earnings_ahead_of_cash", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "Net income below cash, but the accrual ratio rises two years running (-0.06, -0.05, -0.04): flag under either reading.",
     "inputs": {"years": [{"net_income": 40, "net_income_continuing_ops": 40, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 50, "net_income_continuing_ops": 50, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 60, "net_income_continuing_ops": 60, "operating_cash_flow": 100, "total_assets": 1000}]},
     "expected": {"tata_rising": true, "flag": true}},
    {"id": "eac-accruals-ambiguous", "rule": "flag.earnings_ahead_of_cash", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "The accrual ratio falls, then rises once (-0.05, -0.06, -0.04). One reading flags it, the other does not: ambiguous.",
     "inputs": {"years": [{"net_income": 50, "net_income_continuing_ops": 50, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 40, "net_income_continuing_ops": 40, "operating_cash_flow": 100, "total_assets": 1000},
                          {"net_income": 60, "net_income_continuing_ops": 60, "operating_cash_flow": 100, "total_assets": 1000}]},
     "expected": {"net_income_above_ocf": false, "tata_rising": "ambiguous", "flag": "ambiguous"}},

    {"id": "lives-doc-example", "rule": "flag.longer_asset_lives", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "The doc's example: carrying 500, remaining life 2 extended to 3; depreciation 250 -> about 167, about 83 of extra pre-tax profit.",
     "inputs": {"carrying_amount": 500, "residual_value": 0, "old_remaining_life": 2, "new_remaining_life": 3},
     "expected": {"depreciable_base": 500, "depreciation_old_basis": 250, "depreciation_new_basis": 166.66666666666666, "extra_pretax_profit": 83.33333333333334, "flag": true}},
    {"id": "lives-shortened", "rule": "flag.longer_asset_lives", "case": "pass", "doc": "docs/signals.md#forensic-flags",
     "description": "A shorter life lowers profit and is not this flag.",
     "inputs": {"carrying_amount": 500, "residual_value": 0, "old_remaining_life": 3, "new_remaining_life": 2},
     "expected": {"extra_pretax_profit": -83.33333333333334, "flag": false}},
    {"id": "lives-unchanged", "rule": "flag.longer_asset_lives", "case": "boundary", "doc": "docs/signals.md#forensic-flags",
     "description": "Unchanged life: no extra profit, no flag.",
     "inputs": {"carrying_amount": 500, "residual_value": 0, "old_remaining_life": 3, "new_remaining_life": 3},
     "expected": {"extra_pretax_profit": 0, "flag": false}},
    {"id": "lives-residual", "rule": "flag.longer_asset_lives", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "Residual value comes off the base: (600 - 100) / 2 = 250 against 500 / 4 = 125.",
     "inputs": {"carrying_amount": 600, "residual_value": 100, "old_remaining_life": 2, "new_remaining_life": 4},
     "expected": {"depreciable_base": 500, "extra_pretax_profit": 125, "flag": true}},

    {"id": "mscore-high-cutoff-between", "rule": "flag.mscore", "case": "pass", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -1.50, a score of -1.60 is above the band (-2.22 to -1.78) and below the cutoff: neither.",
     "inputs": {"m_score": -1.60, "cutoff": -1.50, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "none"}},
    {"id": "mscore-high-cutoff-band", "rule": "flag.mscore", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -1.50, a score of -2.00 is in the fixed band: read closely.",
     "inputs": {"m_score": -2.00, "cutoff": -1.50, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "read_closely"}},
    {"id": "mscore-high-cutoff-flag", "rule": "flag.mscore", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -1.50, a score of -1.40 is a flag.",
     "inputs": {"m_score": -1.40, "cutoff": -1.50, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "flag"}},
    {"id": "mscore-high-cutoff-band-edge", "rule": "flag.mscore", "case": "boundary", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -1.50, a score exactly at the band's upper edge -1.78 is ambiguous.",
     "inputs": {"m_score": -1.78, "cutoff": -1.50, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "ambiguous_boundary"}},
    {"id": "mscore-cutoff-inside-band-overlap", "rule": "flag.mscore", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -2.00 inside the band, a score of -1.90 is above the cutoff and inside the band: ambiguous.",
     "inputs": {"m_score": -1.90, "cutoff": -2.00, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "ambiguous_overlap"}},
    {"id": "mscore-cutoff-inside-band-below", "rule": "flag.mscore", "case": "edge", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -2.00, a score of -2.10 is in the band and below the cutoff: read closely.",
     "inputs": {"m_score": -2.10, "cutoff": -2.00, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "read_closely"}},
    {"id": "mscore-cutoff-inside-band-above", "rule": "flag.mscore", "case": "fail", "doc": "docs/signals.md#forensic-flags",
     "description": "With a cutoff of -2.00, a score of -1.70 is above the band and the cutoff: flag.",
     "inputs": {"m_score": -1.70, "cutoff": -2.00, "cutoff_source": "made-up cutoff for this vector"},
     "expected": {"status": "flag"}}
  ]
}
