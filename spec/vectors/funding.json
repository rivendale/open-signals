{
  "about": "Synthetic vectors for TTM, funding dependence and SR-1a. Made-up numbers; no real company.",
  "vectors": [
    {"id": "ttm-across-years", "rule": "ttm", "case": "pass", "doc": "docs/signals.md#funding-dependence",
     "description": "TTM at the second quarter spans two fiscal years: Q3 and Q4 of the prior year plus Q1 and Q2.",
     "inputs": {"fiscal_years": [{"ytd_3m": 100, "ytd_6m": 220, "ytd_9m": 360, "ytd_12m": 500}, {"ytd_3m": 130, "ytd_6m": 270}]},
     "expected": {"quarters": [100, 120, 140, 140, 130, 140], "ttm": 550}},
    {"id": "ttm-q4-is-fy-minus-9m", "rule": "ttm", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "Q4 = full year - nine-month year to date (480 - 330 = 150), not a quarter times four.",
     "inputs": {"fiscal_years": [{"ytd_3m": 90, "ytd_6m": 200, "ytd_9m": 330, "ytd_12m": 480}]},
     "expected": {"quarters": [90, 110, 130, 150], "ttm": 480}},
    {"id": "ttm-exactly-four-quarters", "rule": "ttm", "case": "boundary", "doc": "docs/signals.md#funding-dependence",
     "description": "Four quarters is the minimum; the last four are summed.",
     "inputs": {"fiscal_years": [{"ytd_3m": 10, "ytd_6m": 30, "ytd_9m": 60, "ytd_12m": 100}]},
     "expected": {"ttm": 100}},
    {"id": "ttm-too-few-quarters", "rule": "ttm", "case": "fail", "doc": "docs/signals.md#funding-dependence",
     "description": "Two quarters cannot make a TTM; a quarter is never multiplied by four.",
     "inputs": {"fiscal_years": [{"ytd_3m": 130, "ytd_6m": 270}]},
     "expect_error": "four quarters"},

    {"id": "fd-doc-example", "rule": "signal.funding_dependence", "case": "pass", "doc": "docs/signals.md#funding-dependence",
     "description": "The doc's example: burn 400; 350 issued, 50 repurchased, 200 net new debt; external funding 500; dependence 1.25.",
     "inputs": {"operating_cash_flow": -100, "stock_based_compensation": 0, "capital_expenditure": 300, "finance_lease_principal_paid": 0, "stock_issued": 350, "stock_repurchased": 50, "net_new_debt": 200},
     "expected": {"free_cash_flow": -400, "cash_burn": 400, "net_stock_issued": 300, "external_funding": 500, "funding_dependence": 1.25}},
    {"id": "fd-external-funding-negative", "rule": "signal.funding_dependence", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "External funding below 0 (buybacks, no raise): dependence is not applicable, never 0.",
     "inputs": {"operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 0, "stock_repurchased": 50, "net_new_debt": 0},
     "expected": {"cash_burn": 400, "external_funding": -50, "funding_dependence": "not_applicable"}},
    {"id": "fd-external-funding-zero", "rule": "signal.funding_dependence", "case": "boundary", "doc": "docs/signals.md#funding-dependence",
     "description": "External funding exactly 0 is also not applicable.",
     "inputs": {"operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 50, "stock_repurchased": 50, "net_new_debt": 0},
     "expected": {"external_funding": 0, "funding_dependence": "not_applicable"}},
    {"id": "fd-no-burn", "rule": "signal.funding_dependence", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "Cash burn 0: not applicable, even with stock issued.",
     "inputs": {"operating_cash_flow": 500, "capital_expenditure": 100, "stock_issued": 100},
     "expected": {"free_cash_flow": 400, "cash_burn": 0, "funding_dependence": "not_applicable"}},
    {"id": "fd-vendor-negative-outflows", "rule": "signal.funding_dependence", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "A vendor reports capex, finance-lease principal and repurchases as negative numbers; they are flipped, giving the doc example's result.",
     "inputs": {"outflow_sign_convention": "negative", "operating_cash_flow": -100, "capital_expenditure": -300, "finance_lease_principal_paid": 0, "stock_issued": 350, "stock_repurchased": -50, "net_new_debt": 200},
     "expected": {"free_cash_flow": -400, "external_funding": 500, "funding_dependence": 1.25}},
    {"id": "fd-unflipped-sign-rejected", "rule": "signal.funding_dependence", "case": "fail", "doc": "docs/data-quality.md#fundamentals",
     "description": "Declared positive outflows but capex arrives negative: rejected rather than added.",
     "inputs": {"operating_cash_flow": -100, "capital_expenditure": -300, "stock_issued": 350},
     "expect_error": "sign"},
    {"id": "fd-ifrs-normalized", "rule": "signal.funding_dependence", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "IFRS: lease principal 120 and interest 30 shown in financing move into operating cash flow (200 -> 50), and finance-lease principal is not deducted again.",
     "inputs": {"basis": "IFRS", "operating_cash_flow": 200, "ifrs_lease_principal_paid": 120, "ifrs_interest_paid_in_financing": 30, "finance_lease_principal_paid": 0, "capital_expenditure": 250, "stock_issued": 300},
     "expected": {"operating_cash_flow_normalized": 50, "free_cash_flow": -200, "funding_dependence": 1.5}},
    {"id": "fd-ifrs-lease-counted-twice", "rule": "signal.funding_dependence", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "IFRS with finance-lease principal also deducted would count leases twice: rejected.",
     "inputs": {"basis": "IFRS", "operating_cash_flow": 200, "ifrs_lease_principal_paid": 120, "finance_lease_principal_paid": 120, "capital_expenditure": 250},
     "expect_error": "second time"},

    {"id": "sr1a-doc-example-fires", "rule": "SR-1a", "case": "fail", "doc": "docs/signals.md#funding-dependence",
     "description": "Dependence 1.25 with negative free cash flow: SR-1a fires.",
     "inputs": {"sleeve": "growth", "operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 350, "stock_repurchased": 50, "net_new_debt": 200},
     "expected": {"funding_dependence": 1.25, "fires": true}},
    {"id": "sr1a-below-one", "rule": "SR-1a", "case": "pass", "doc": "docs/signals.md#funding-dependence",
     "description": "Burn 400, external funding 300: dependence 0.75, does not fire.",
     "inputs": {"sleeve": "growth", "operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 200, "net_new_debt": 100},
     "expected": {"funding_dependence": 0.75, "fires": false}},
    {"id": "sr1a-exactly-one", "rule": "SR-1a", "case": "boundary", "doc": "docs/signals.md#funding-dependence",
     "description": "Dependence exactly 1.0 is not above 1.0: does not fire.",
     "inputs": {"sleeve": "growth", "operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 400},
     "expected": {"funding_dependence": 1.0, "fires": false}},
    {"id": "sr1a-just-above-one", "rule": "SR-1a", "case": "boundary", "doc": "docs/signals.md#funding-dependence",
     "description": "Dependence 1.0025: fires.",
     "inputs": {"sleeve": "growth", "operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 401},
     "expected": {"funding_dependence": 1.0025, "fires": true}},
    {"id": "sr1a-not-applicable-does-not-fire", "rule": "SR-1a", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "Burns cash and raises nothing: dependence not applicable, SR-1a does not fire (SR-1b may).",
     "inputs": {"sleeve": "growth", "operating_cash_flow": -100, "capital_expenditure": 300},
     "expected": {"funding_dependence": "not_applicable", "fires": false}},
    {"id": "sr1a-sbc-shortfall-literal", "rule": "SR-1a", "case": "edge", "doc": "docs/signals.md#funding-dependence",
     "description": "Operating cash flow +100, stock-based compensation 150: free cash flow -50 by the doc's definition; with 100 of stock issued, dependence 2.0 and SR-1a fires. The stock-based-compensation guard in the docs is stated for SR-1b only.",
     "inputs": {"sleeve": "growth", "operating_cash_flow": 100, "stock_based_compensation": 150, "capital_expenditure": 0, "stock_issued": 100},
     "expected": {"free_cash_flow": -50, "funding_dependence": 2.0, "fires": true}},
    {"id": "sr1a-speculative-sleeve", "rule": "SR-1a", "case": "edge", "doc": "docs/pipeline.md#speculative-sleeve",
     "description": "Same inputs as the doc example, in the speculative sleeve: not applied.",
     "inputs": {"sleeve": "speculative", "operating_cash_flow": -100, "capital_expenditure": 300, "stock_issued": 350, "stock_repurchased": 50, "net_new_debt": 200},
     "expected": {"funding_dependence": 1.25, "fires": "not_applied"}}
  ]
}
