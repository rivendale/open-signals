{
  "about": "Synthetic vectors for collar pricing and ranking. They check net credit, status and order only, and stop before any yield figure (COMPLIANCE.md, guardrail 3). Made-up quotes; no real security.",
  "vectors": [
    {"id": "collar-doc-input", "rule": "collar.price", "case": "pass", "doc": "docs/signals.md#collar-plus-income",
     "description": "The doc's worked input: call bid 2.10, put ask 0.60, net credit 1.50.",
     "inputs": {"call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 30},
     "expected": {"status": "priced", "net_credit": 1.5}},
    {"id": "collar-zero-days", "rule": "collar.price", "case": "edge", "doc": "docs/signals.md#collar-plus-income",
     "description": "Zero days to expiration: excluded, never annualized.",
     "inputs": {"call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 0},
     "expected": {"status": "excluded", "net_credit": 1.5}},
    {"id": "collar-one-day", "rule": "collar.price", "case": "boundary", "doc": "docs/signals.md#collar-plus-income",
     "description": "One day to expiration is the minimum: priced.",
     "inputs": {"call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 1},
     "expected": {"status": "priced"}},
    {"id": "collar-zero-put-ask", "rule": "collar.price", "case": "fail", "doc": "docs/signals.md#collar-plus-income",
     "description": "A zero ask means the leg cannot be priced, never that it is free.",
     "inputs": {"call_bid": 2.10, "put_ask": 0, "spot": 100, "days_to_expiration": 30},
     "expected": {"status": "cannot_price"}},
    {"id": "collar-missing-call-bid", "rule": "collar.price", "case": "fail", "doc": "docs/signals.md#collar-plus-income",
     "description": "A missing bid means the leg cannot be priced.",
     "inputs": {"put_ask": 0.60, "spot": 100, "days_to_expiration": 30},
     "expected": {"status": "cannot_price"}},

    {"id": "rank-by-annualized", "rule": "collar.rank", "case": "pass", "doc": "docs/signals.md#collar-plus-income",
     "description": "A (credit 1.50, 30 days) ranks ahead of B (credit 2.00, 90 days): ranking is on annualized net, not raw credit. C (0 days) and D (zero ask) are excluded.",
     "inputs": {"candidates": [
       {"id": "B", "call_bid": 3.00, "put_ask": 1.00, "spot": 100, "days_to_expiration": 90},
       {"id": "A", "call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 30},
       {"id": "C", "call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 0},
       {"id": "D", "call_bid": 2.10, "put_ask": 0, "spot": 100, "days_to_expiration": 30}]},
     "expected": {"order": ["A", "B"], "excluded": ["C", "D"]}},
    {"id": "rank-one-day-included", "rule": "collar.rank", "case": "boundary", "doc": "docs/signals.md#collar-plus-income",
     "description": "A one-day candidate is ranked, not excluded.",
     "inputs": {"candidates": [
       {"id": "E", "call_bid": 0.50, "put_ask": 0.40, "spot": 100, "days_to_expiration": 1},
       {"id": "C", "call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 0}]},
     "expected": {"order": ["E"], "excluded": ["C"]}},
    {"id": "rank-none-priced", "rule": "collar.rank", "case": "fail", "doc": "docs/signals.md#collar-plus-income",
     "description": "Nothing can be priced: an empty ranking.",
     "inputs": {"candidates": [
       {"id": "C", "call_bid": 2.10, "put_ask": 0.60, "spot": 100, "days_to_expiration": 0},
       {"id": "D", "call_bid": 0, "put_ask": 0.60, "spot": 100, "days_to_expiration": 30}]},
     "expected": {"order": [], "excluded": ["C", "D"]}}
  ]
}
